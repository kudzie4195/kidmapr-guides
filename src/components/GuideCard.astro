---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  timeEstimate: string;
  isFree: boolean;
  isNew?: boolean;
  category: string;
}

const {
  title,
  description,
  icon,
  href,
  timeEstimate,
  isFree,
  isNew = false,
  category,
} = Astro.props;

// Category badge styles
const categoryStyles: Record<string, string> = {
  childcare:    'bg-teal-50 text-teal-800',
  'k-transition': 'bg-indigo-50 text-indigo-800',
  financial:    'bg-emerald-50 text-emerald-800',
  provider:     'bg-amber-50 text-amber-800',
};

const categoryLabels: Record<string, string> = {
  childcare:    'Childcare',
  'k-transition': 'K Transition',
  financial:    'Financial',
  provider:     'Provider',
};

const badgeStyle = categoryStyles[category] ?? 'bg-slate-100 text-slate-700';
const badgeLabel = categoryLabels[category] ?? category;
---

<a
  href={href}
  class="group flex flex-col bg-white border border-slate-100 rounded-2xl p-5 hover:shadow-md transition-shadow duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
  aria-label={`Open guide: ${title}`}
>
  <!-- Top row: category badge + badges -->
  <div class="flex items-start justify-between gap-2 mb-3">
    <span
      class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${badgeStyle}`}
    >
      {badgeLabel}
    </span>
    <div class="flex items-center gap-1.5 shrink-0">
      {isNew && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-violet-50 text-violet-700 border border-violet-100">
          New
        </span>
      )}
      {isFree && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          Free
        </span>
      )}
    </div>
  </div>

  <!-- Icon + Title -->
  <div class="flex items-start gap-3 mb-2">
    <span class="text-2xl shrink-0 leading-none mt-0.5" aria-hidden="true">{icon}</span>
    <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-700 transition-colors leading-snug">
      {title}
    </h3>
  </div>

  <!-- Description -->
  <p class="text-xs text-slate-500 leading-relaxed line-clamp-2 mb-4 pl-9">
    {description}
  </p>

  <!-- Bottom: time estimate + CTA -->
  <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
    <!-- Time estimate -->
    <span class="flex items-center gap-1 text-xs text-slate-400">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-3.5 h-3.5"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
          clip-rule="evenodd"
        />
      </svg>
      {timeEstimate}
    </span>

    <!-- CTA button -->
    <span
      class="inline-flex items-center justify-center w-full max-w-[130px] bg-emerald-600 group-hover:bg-emerald-700 text-white text-xs font-semibold py-1.5 px-3 rounded-lg transition-colors"
    >
      Open guide →
    </span>
  </div>
</a>
