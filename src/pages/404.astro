---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | CloverMap Guides"
  description="We couldn't find that guide. Browse the CloverMap Guide Library for free Georgia family resources."
  noIndex={true}
>
  <!-- ─── Site Header ───────────────────────────────────────────────── -->
  <header class="sticky top-0 z-50 bg-white border-b border-slate-100 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="https://www.clovermap.com/guides" class="flex items-center gap-2 font-semibold text-slate-900 hover:opacity-80 transition-opacity">
        <svg width="26" height="24" viewBox="0 0 48 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3,27 Q24,3 45,27" stroke="#a5b4fc" stroke-width="3" stroke-linecap="round" fill="none"/>
          <circle cx="10" cy="18" r="3.5" fill="#4f46e5"/>
          <line x1="10" y1="21.5" x2="10" y2="34" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="10" y1="25" x2="3" y2="18" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="10" y1="25" x2="17" y2="18" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="10" y1="34" x2="7" y2="42" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="10" y1="34" x2="13" y2="42" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="24" cy="21" r="2.5" fill="#10b981"/>
          <line x1="24" y1="23.5" x2="24" y2="34" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
          <line x1="24" y1="27" x2="18" y2="21" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
          <line x1="24" y1="27" x2="30" y2="21" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
          <line x1="24" y1="34" x2="21" y2="42" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
          <line x1="24" y1="34" x2="27" y2="42" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
          <circle cx="38" cy="18" r="3.5" fill="#6366f1"/>
          <line x1="38" y1="21.5" x2="38" y2="34" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="38" y1="25" x2="31" y2="18" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="38" y1="25" x2="45" y2="18" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="38" y1="34" x2="35" y2="42" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="38" y1="34" x2="41" y2="42" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span style="color:#059669" class="font-bold">Clover</span><span class="font-bold text-slate-800 -ml-1">Map</span>
        <span class="font-normal text-slate-500 ml-1">Guide Library</span>
      </a>
      <a
        href="https://www.clovermap.com"
        class="text-sm text-slate-600 hover:text-clover-600 transition-colors flex items-center gap-1"
      >
        <span aria-hidden="true">←</span> Back to CloverMap
      </a>
    </div>
  </header>

  <!-- ─── 404 Body ───────────────────────────────────────────────────── -->
  <main class="min-h-[calc(100vh-56px)] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-md">
      <!-- Large 404 -->
      <p class="text-8xl font-extrabold text-slate-200 leading-none select-none mb-6" aria-hidden="true">
        404
      </p>

      <h1 class="text-2xl font-bold text-slate-900 mb-3">
        We couldn't find that guide.
      </h1>
      <p class="text-slate-500 mb-10">
        The page you're looking for may have moved, or the URL might be
        incorrect. Try the guide library or search for a daycare near you.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="https://www.clovermap.com/guides"
          class="inline-flex items-center gap-2 bg-indigo-600 text-white font-semibold px-6 py-3 rounded-xl hover:bg-indigo-700 transition-colors shadow-sm w-full sm:w-auto justify-center"
        >
          <span aria-hidden="true">📚</span> Browse the guide library
        </a>
        <a
          href="https://www.clovermap.com/Browse"
          class="inline-flex items-center gap-2 bg-white text-clover-700 border border-clover-200 font-semibold px-6 py-3 rounded-xl hover:bg-clover-50 transition-colors shadow-sm w-full sm:w-auto justify-center"
        >
          <span aria-hidden="true">🍀</span> Search daycares
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
